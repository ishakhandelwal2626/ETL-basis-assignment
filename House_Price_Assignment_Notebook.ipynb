   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "df['number of bedrooms'].mode()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7fefc5a5",
   "metadata": {},
   "source": [
    "## Q3 Check Price Skewness"
   ]
  },
  {
   "cell_type": "code",
